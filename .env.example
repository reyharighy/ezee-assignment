# Database
DATABASE_USERNAME=defaultusername
DATABASE_PASSWORD=defaultpassword
DATABASE_NAME=defaultdatabasename

# Database Admin
DB_ADMIN_EMAIL=default@email.com
DB_ADMIN_PASSWORD=defaultpassword

# Embedding
EMBEDDING_MODEL=embed-multilingual-v3.0 # if not set, default embed-multilingual-v3.0 [optional]
EMBEDDING_DIMENSION=1024 # if not set, default 1024 (for embed-multilingual-v3.0 - must match the model) [optional]
COHERE_API_KEY=cohere-api-key # https://dashboard.cohere.com/api-keys

# Health Check
HEALTH_CHECK_PROVIDER_CACHE_TTL=300 # if not set, default 300 seconds [optional]

# Job Queue
JOB_QUEUE_URL=redis://job_queue:6379 # domain based on the service name
JOB_QUEUE_RESULT_TTL=-1 # if not set, default -1 = forever, in seconds [optional]

# Language Model
GROQ_API_KEY=groq-api-key # https://console.groq.com/keys
LLM_MODEL=openai/gpt-oss-20b

# Observability 
LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=langsmith-api-key
LANGSMITH_PROJECT=default-project